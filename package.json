{
	"name": "obsidian-gitlab-mr",
	"version": "0.1.0",
	"description": "Reference GitLab merge requests in Obsidian and see their live status.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --experimental-test-isolation=none --test tests/parser.test.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"gitlab",
		"merge-request"
	],
	"author": "Ris Adams",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^26.4.1",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.69.0",
		"builtin-modules": "^5.3.0",
		"esbuild": "^0.28.2",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"typescript": "^5.6.3"
	}
}
