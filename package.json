{
	"name": "obsidian-gitlab-mr",
	"version": "0.1.0",
	"description": "Reference GitLab merge requests in Obsidian and see their live status.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"gitlab",
		"merge-request"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.69.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.0",
		"obsidian": "^1.5.7",
		"tslib": "^2.6.2",
		"typescript": "^5.3.3"
	}
}
